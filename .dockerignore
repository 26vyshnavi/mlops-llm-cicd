# Files excluded from the Docker build context.
# Smaller context = faster builds (no need to transfer 300 MB of model weights
# to the Docker daemon before it even starts building).

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Model weights (loaded from HF Hub at runtime, not baked into the image)
model_output/
*.bin
*.safetensors
*.pt
*.ckpt

# Tests & dev tools (not needed in production image)
tests/
.coverage
coverage.xml
htmlcov/
.pytest_cache/

# Git
.git/
.gitignore

# CI
.github/

# Editor
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/
